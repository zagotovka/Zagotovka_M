################################################################################
# Custom build targets - вставляется в конец auto-generated makefile
################################################################################

# Проверка результата веб-сборки.
# Скрипт build_web_and_pack.sh запускается из makefile.init при чтении makefile
# (через $(shell ...)), поэтому его код возврата терялся. Теперь перед линковкой
# выполняется проверка файла-признака, который скрипт пишет только в самом конце.
# При ошибке удаляются старые .elf и .bin (и копия в Proshivka), чтобы нельзя
# было случайно прошить устаревшую прошивку со старым интерфейсом.
.PHONY: web-build-check
web-build-check:
	@sh ../scripts/check_web_build.sh || { \
		rm -f $(EXECUTABLES) $(BUILD_ARTIFACT_NAME).bin ../Proshivka/$(BUILD_ARTIFACT_NAME)_v*.bin; \
		exit 1; \
	}

# Линковка возможна только после успешной проверки веб-сборки
$(EXECUTABLES): web-build-check

# Генерация .bin из .elf.
# Auto-generated makefile уже содержит правило для .bin, если конфигурация
# создаёт OBJCOPY_BIN (Bank_A). Переопределять его нельзя - make выдаёт
# "warning: overriding recipe". Поэтому своё правило добавляем только когда
# генератор .bin не создаёт (Bank_B).
ifeq ($(filter $(BUILD_ARTIFACT_NAME).bin,$(OBJCOPY_BIN)),)
$(BUILD_ARTIFACT_NAME).bin: $(EXECUTABLES)
	arm-none-eabi-objcopy -O binary $(EXECUTABLES) $@
	@echo 'Generated: $@'
endif

# Копирование готового .bin в Proshivka с версией в имени
.PHONY: copy-to-proshivka
copy-to-proshivka: $(BUILD_ARTIFACT_NAME).bin
	@mkdir -p ../Proshivka
	@rm -f ../Proshivka/$(BUILD_ARTIFACT_NAME)_v*.bin
	@FW_VER=$$(cat ../VERSION | tr -d '[:space:]'); \
	cp $< ../Proshivka/$(BUILD_ARTIFACT_NAME)_v$$FW_VER.bin; \
	echo "Copied to Proshivka/$(BUILD_ARTIFACT_NAME)_v$$FW_VER.bin"

# Расширяем secondary-outputs чтобы .bin создавался при каждом билде
secondary-outputs: copy-to-proshivka
